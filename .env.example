# ==============================================================================
# CivicPulse Environment Configuration (.env.example / .env.local)
# ==============================================================================
# Copy this file to .env.local and populate the values below before running the app.

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# - NEXT_PUBLIC_SUPABASE_URL: Your Project URL (e.g., https://your-project.supabase.co)
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Your 'anon' or 'publishable' client key
# - SUPABASE_SERVICE_ROLE_KEY: Your 'service_role' (secret) server key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration (Required for AI Triage & Analysis)
# ------------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
# - GEMINI_API_KEY: Secret API key used server-side for civic photo categorization,
#   severity estimation, duplicate matching, and municipal department routing.
# - GEMINI_MODEL: (Optional) Model name to use (defaults to gemini-2.5-flash).
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Application Domain (Optional)
# ------------------------------------------------------------------------------
# Base domain used for Auth confirmation emails, redirects, and canonical links.
# Defaults to http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
